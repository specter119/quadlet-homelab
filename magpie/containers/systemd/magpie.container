[Unit]
Description=Magpie AI Agent Model Manager
After=traefik.service
Wants=traefik.service

{{#if (command_success "uname -r | grep -qi wsl")}}
[Quadlet]
DefaultDependencies=false

{{/if}}
[Service]
ExecStartPre=/usr/bin/mkdir -p %E/magpie
Restart=always

[Container]
Image=ghcr.io/yetone/magpie:latest
Pull=newer
Network=traefik.network
UserNS=keep-id:uid=65532,gid=65532
User=65532:65532
# Persistence layout: see docs/magpie.md
Volume=magpie-data.volume:/config
Volume=%E/magpie:/config/magpie:Z
# Corporate MITM proxy: container (Distroless) has no company roots, so every
# HTTPS call (plugin market list, bun download, models.dev) fails TLS verify.
# Reuse the host's updated CA bundle for the files SSL_CERT_FILE points at.
Volume=/etc/ssl/certs/ca-certificates.crt:/etc/ssl/certs/ca-certificates.crt:ro,Z
Environment=MAGPIE_ADDR=0.0.0.0:3425
# magpie's own (Go) npm-metadata fetches: npmjs is blocked, so they are
# mirrored through Traefik's internal npm-mirror rewriter (:8081, addPrefix +
# %2F decode + Bearer) to company Artifactory. Plugin installs need none of
# this (they use plugins/bunfig.toml; keep chinaMirror OFF in the UI).
Environment=MAGPIE_MIRRORS=on
Environment=MAGPIE_NPM_REGISTRY=http://systemd-traefik:8081
PublishPort=127.0.0.1:3425:3425
Secret=magpie-web-key,type=env,target=MAGPIE_WEB_KEY
Exec=web --addr 0.0.0.0:3430 --no-open

# Dozzle group
Label=dev.dozzle.group=quadlet

# Traefik labels
Label=traefik.enable=true
Label=traefik.docker.network=systemd-traefik

# HTTP -> HTTPS redirect
Label=traefik.http.routers.magpie-http.entrypoints=http
Label=traefik.http.routers.magpie-http.middlewares=redir-https@file
Label=traefik.http.routers.magpie-http.rule=Host(`magpie.{{domain}}`)
Label=traefik.http.routers.magpie-http.service=noop@internal

# HTTPS
Label=traefik.http.routers.magpie-https.entrypoints=https
Label=traefik.http.routers.magpie-https.tls=true
Label=traefik.http.routers.magpie-https.middlewares=gzip@file
Label=traefik.http.routers.magpie-https.rule=Host(`magpie.{{domain}}`)
Label=traefik.http.services.magpie.loadbalancer.server.port=3430

{{#if (contains autostart_services "magpie")}}
[Install]
WantedBy=default.target
{{/if}}
