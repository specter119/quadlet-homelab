[Unit]
Description=CLIProxyAPI - OpenAI/Gemini/Claude Compatible Proxy
After=traefik.service
Wants=traefik.service

{{#if (command_success "uname -r | grep -qi wsl")}}
[Quadlet]
DefaultDependencies=false

{{/if}}
[Service]
Restart=always

[Container]
{{#if (command_success "timedatectl show -p Timezone --value")}}
Environment=TZ={{command_output "timedatectl show -p Timezone --value"}}
{{/if}}
Image=docker.io/eceasy/cli-proxy-api:latest
Pull=newer

Network=traefik.network

# Config and data mounts
Volume=%E/cliproxyapi/config.yaml:/CLIProxyAPI/config.yaml:Z
Volume=cliproxyapi-auth:/root/.cli-proxy-api

# Dozzle group
Label=dev.dozzle.group=quadlet

# Traefik labels
Label=traefik.enable=true
Label=traefik.docker.network=systemd-traefik

# HTTP -> HTTPS redirect
Label=traefik.http.routers.cliproxyapi-http.entrypoints=http
Label=traefik.http.routers.cliproxyapi-http.middlewares=redir-https@file
Label=traefik.http.routers.cliproxyapi-http.rule=Host(`cliproxyapi.{{domain}}`)
Label=traefik.http.routers.cliproxyapi-http.service=noop@internal

# HTTPS
Label=traefik.http.routers.cliproxyapi-https.entrypoints=https
Label=traefik.http.routers.cliproxyapi-https.tls=true
Label=traefik.http.routers.cliproxyapi-https.middlewares=gzip@file,cliproxyapi-rewrite@docker
Label=traefik.http.routers.cliproxyapi-https.rule=Host(`cliproxyapi.{{domain}}`)
Label=traefik.http.services.cliproxyapi.loadbalancer.server.port=8317

# Root path rewrite middleware
Label=traefik.http.middlewares.cliproxyapi-rewrite.replacepathregex.regex=^/$
Label=traefik.http.middlewares.cliproxyapi-rewrite.replacepathregex.replacement=/management.html

{{#if (contains autostart_services "cliproxyapi")}}
[Install]
WantedBy=default.target
{{/if}}
