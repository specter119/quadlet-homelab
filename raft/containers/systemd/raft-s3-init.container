[Unit]
Description=Raft S3 Bucket and Credentials Init (Silo)
PartOf=raft.target
After=silo.service
Requires=silo.service

{{#if (command_success "uname -r | grep -qi wsl")}}
[Quadlet]
DefaultDependencies=false

{{/if}}
[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=5s

[Container]
Image=docker.io/pgsty/silo:RELEASE.2026-09-16T00-00-00Z
Entrypoint=/bin/sh
Exec=/init.sh
# 只建私有附件桶。不建 CDN 桶：storageService 在缺少 S3_CDN_BUCKET/CDN_BASE_URL 时
# 会回落到主桶 + 服务端路由，也就不需要给任何桶开匿名读（见 docs/raft.md）。
Environment=S3_BUCKETS=raft

Network=raft.network
Volume=%h/.config/silo/s3-init.sh:/init.sh:ro,Z

Secret=silo-root-user,type=env,target=MINIO_ROOT_USER
Secret=silo-root-password,type=env,target=MINIO_ROOT_PASSWORD
Secret=raft-s3-access-key,type=env,target=S3_ACCESS_KEY
Secret=raft-s3-secret-key,type=env,target=S3_SECRET_KEY

# Dozzle group
Label=dev.dozzle.group=quadlet

[Install]
WantedBy=raft.target
