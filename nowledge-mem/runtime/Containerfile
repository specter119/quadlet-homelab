FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates curl gnupg libgomp1 \
    && curl -fsSL https://nowledge-co.github.io/community/apt/install.sh | bash \
    && apt-get update \
    && apt-get install -y --no-install-recommends nowledge-mem \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 14242
