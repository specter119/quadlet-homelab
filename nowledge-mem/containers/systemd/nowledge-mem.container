[Unit]
Description=Nowledge Mem Headless Server
After=traefik.service
Wants=traefik.service
Wants=nowledge-mem-sync-key.service

{{#if (command_success "uname -r | grep -qi wsl")}}
[Quadlet]
DefaultDependencies=false

{{/if}}
[Service]
ExecStartPre=/usr/bin/mkdir -p %E/co.nowledge.mem.desktop %D/NowledgeGraph %C/nowledge-graph %C/huggingface
Restart=always

[Container]
{{#if (command_success "timedatectl show -p Timezone --value")}}
Environment=TZ={{command_output "timedatectl show -p Timezone --value"}}
{{/if}}
Image=docker.io/nowledgelabs/mem
Pull=newer
UserNS=keep-id:uid=10001,gid=10001
NoNewPrivileges=true
Network=traefik.network

# 官方镜像布局：XDG_CONFIG_HOME=/etc/nowledge-mem
# XDG_DATA_HOME=/var/lib/nowledge-mem  XDG_CACHE_HOME=/var/cache/nowledge-mem
# 宿主侧路径保持与 docs/nowledge-mem.md 一致，避免迁移既有数据
Volume=%h/.config/co.nowledge.mem.desktop:/etc/nowledge-mem/co.nowledge.mem.desktop:Z
Volume=%h/.local/share/NowledgeGraph:/var/lib/nowledge-mem/NowledgeGraph:Z
Volume=%h/.cache/nowledge-graph:/var/cache/nowledge-mem:Z
Volume=%h/.cache/huggingface:/var/cache/nowledge-mem/huggingface:Z
# Local embedding GGUF lands in /var/lib/nowledge-mem/.cache/nmem-rs/models, which
# is otherwise an anonymous image volume discarded on every restart. Named volume,
# not a host path: it is a re-downloadable cache.
Volume=nowledge-mem-models.volume:/var/lib/nowledge-mem/.cache
# Corporate MITM proxy: the image has no company roots, so model downloads
# (ModelScope / Hugging Face) fail TLS verify. See docs/quadlet.md.
Volume=/etc/ssl/certs/ca-certificates.crt:/etc/ssl/certs/ca-certificates.crt:ro
# Kuzu needs time to checkpoint on shutdown; the 10s default ends in SIGKILL.
StopTimeout=60

# Dozzle group
Label=dev.dozzle.group=quadlet

# Traefik labels
Label=traefik.enable=true
Label=traefik.docker.network=systemd-traefik

# HTTP -> HTTPS redirect
Label=traefik.http.routers.nowledge-mem-http.entrypoints=http
Label=traefik.http.routers.nowledge-mem-http.middlewares=redir-https@file
Label=traefik.http.routers.nowledge-mem-http.rule=Host(`nowledge-mem.{{domain}}`)
Label=traefik.http.routers.nowledge-mem-http.service=noop@internal

# HTTPS
Label=traefik.http.routers.nowledge-mem-https.entrypoints=https
Label=traefik.http.routers.nowledge-mem-https.tls=true
Label=traefik.http.routers.nowledge-mem-https.middlewares=gzip@file,nowledge-mem-root@docker
Label=traefik.http.routers.nowledge-mem-https.rule=Host(`nowledge-mem.{{domain}}`)
Label=traefik.http.services.nowledge-mem.loadbalancer.server.port=14242

# Redirect the bare host to the web app entrypoint.
Label=traefik.http.middlewares.nowledge-mem-root.replacepathregex.regex=^/$
Label=traefik.http.middlewares.nowledge-mem-root.replacepathregex.replacement=/app

{{#if (contains autostart_services "nowledge-mem")}}
[Install]
WantedBy=default.target
{{/if}}
