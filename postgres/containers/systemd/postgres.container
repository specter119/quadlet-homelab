[Unit]
Description=Shared PostgreSQL Database (pgvector)
{{#if (command_success "uname -r | grep -qi wsl")}}
[Quadlet]
DefaultDependencies=false
{{/if}}
[Service]
Restart=always
TimeoutStartSec=5min
[Container]
Image=docker.io/pgvector/pgvector:pg17
# wal_level=logical：RisingWave 的 postgres-cdc 源需要逻辑复制（PG 默认 replica）。
# max_slot_wal_keep_size=256MB：给 CDC slot 的 WAL 滞留设硬上限。超限时 PG 会作废
# 该 slot（而不是把磁盘填满），后果是 CDC 断、必须全量重建 RisingWave 视图；
# 设计与重建流程见 docs/raft.md。max_replication_slots / max_wal_senders 用 PG 默认
# 的 10，无需显式设置。改这两个参数都需要重启本容器。
Exec=postgres -c wal_level=logical -c max_slot_wal_keep_size=256MB
{{command_output "bash -lc './.dotter/render_networks.sh postgres 2> >(tee -a ~/.cache/dotter-render.log >&2) || true'"}}
NetworkAlias=postgres
Volume=postgres-data.volume:/var/lib/postgresql/data
Environment=POSTGRES_USER=postgres
Secret=postgres-password,type=env,target=POSTGRES_PASSWORD
# 必须探 TCP：不带 -h 时 pg_isready 走 Unix socket，会在 docker-library/postgres
# 首次 initdb 的“仅 socket 临时服务”阶段误报健康（此时 TCP 还没监听）
HealthCmd=pg_isready -h 127.0.0.1 -U postgres -d postgres
Notify=healthy
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=10s

# Dozzle group
Label=dev.dozzle.group=quadlet

# No [Install] - started on-demand by dependent services
