[Unit]
Description=Multica Agent Runtime Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=SSL_CERT_FILE=%h/.local/share/mkcert/rootCA.pem
ExecSearchPath=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStartPre=multica config set server_url https://multica-api.{{domain}}
ExecStartPre=multica config set app_url https://multica.{{domain}}
ExecStart=multica daemon start --foreground
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
