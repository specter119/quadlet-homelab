[Unit]
Description=Multica Agent Runtime Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecSearchPath=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStartPre=multica config set server_url http://localhost:8080
ExecStartPre=multica config set app_url http://localhost:3000
ExecStart=multica daemon start --foreground
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
