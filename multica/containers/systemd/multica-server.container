[Unit]
Description=Multica Server
PartOf=multica.target
After=postgres.service multica-initdb.service multica-migrate.service
Requires=postgres.service multica-initdb.service multica-migrate.service

{{#if (command_success "uname -r | grep -qi wsl")}}
[Quadlet]
DefaultDependencies=false

{{/if}}
[Service]
Restart=always

[Container]
Image=ghcr.io/multica-ai/multica-backend:latest
Pull=newer
Network=multica.network
Network=traefik.network
NetworkAlias=api
NetworkAlias=backend
Volume=multica-backend-uploads.volume:/app/data/uploads

Secret=multica-database-url,type=env,target=DATABASE_URL
Secret=multica-jwt-secret,type=env,target=JWT_SECRET

Environment=PORT=8080
Environment=APP_ENV=production
Environment=FRONTEND_ORIGIN=https://multica.{{domain}}
Environment=CORS_ALLOWED_ORIGINS=https://multica.{{domain}}
Environment=MULTICA_APP_URL=https://multica.{{domain}}
Environment=MULTICA_SERVER_URL=wss://multica.{{domain}}/ws
Environment=MULTICA_PUBLIC_URL=https://multica.{{domain}}
HealthCmd=wget -q -O /dev/null http://127.0.0.1:8080/health

# Dozzle group
Label=dev.dozzle.group=quadlet

# Traefik labels - 供 multica CLI daemon 从宿主机经域名访问 API（不占用宿主机端口）
Label=traefik.enable=true
Label=traefik.docker.network=systemd-traefik

# HTTP -> HTTPS redirect
Label=traefik.http.routers.multica-server-http.entrypoints=http
Label=traefik.http.routers.multica-server-http.rule=Host(`multica-api.{{domain}}`)
Label=traefik.http.routers.multica-server-http.middlewares=redir-https@file
Label=traefik.http.routers.multica-server-http.service=noop@internal

# HTTPS route
Label=traefik.http.routers.multica-server-https.entrypoints=https
Label=traefik.http.routers.multica-server-https.rule=Host(`multica-api.{{domain}}`)
Label=traefik.http.routers.multica-server-https.tls=true
Label=traefik.http.routers.multica-server-https.middlewares=gzip@file
Label=traefik.http.services.multica-server.loadbalancer.server.port=8080

[Install]
WantedBy=multica.target
