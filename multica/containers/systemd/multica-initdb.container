[Unit]
Description=Initialize Multica PostgreSQL database and user
PartOf=multica.target
After=postgres.service
Requires=postgres.service

{{#if (command_success "uname -r | grep -qi wsl")}}
[Quadlet]
DefaultDependencies=false

{{/if}}
[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=2s
ExecStartPre=/usr/bin/podman healthcheck run systemd-postgres

[Container]
Image=docker.io/postgres:17-alpine
Network=multica.network

Secret=postgres-password,type=env,target=PGPASSWORD
Secret=multica-db-password,type=env,target=MULTICA_DB_PASSWORD

Exec=sh -c "psql -v ON_ERROR_STOP=1 -h postgres -U postgres -tc \"SELECT 1 FROM pg_roles WHERE rolname='multica'\" | grep -q 1 || psql -v ON_ERROR_STOP=1 -h postgres -U postgres -c \"CREATE USER multica WITH PASSWORD '$MULTICA_DB_PASSWORD'\"; psql -v ON_ERROR_STOP=1 -h postgres -U postgres -tc \"SELECT 1 FROM pg_database WHERE datname='multica'\" | grep -q 1 || psql -v ON_ERROR_STOP=1 -h postgres -U postgres -c \"CREATE DATABASE multica OWNER multica\"; psql -v ON_ERROR_STOP=1 -h postgres -U postgres -d multica -c \"CREATE EXTENSION IF NOT EXISTS vector\""

# Dozzle group
Label=dev.dozzle.group=quadlet

[Install]
WantedBy=multica.target
