[Unit]
Description=Omnivore S3 Bucket and Credentials Init (Silo)
After=silo.service
Requires=silo.service

{{#if (command_success "uname -r | grep -qi wsl")}}
[Quadlet]
DefaultDependencies=false

{{/if}}
[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=5s

[Container]
Image=docker.io/pgsty/silo:RELEASE.2026-09-16T00-00-00Z
Entrypoint=/bin/sh
Exec=/init.sh
Environment=S3_BUCKET=omnivore

Network=omnivore.network
Volume=%h/.config/silo/s3-init.sh:/init.sh:ro,Z

Secret=silo-root-user,type=env,target=MINIO_ROOT_USER
Secret=silo-root-password,type=env,target=MINIO_ROOT_PASSWORD
Secret=omnivore-s3-access-key,type=env,target=S3_ACCESS_KEY
Secret=omnivore-s3-secret-key,type=env,target=S3_SECRET_KEY

# Dozzle group
Label=dev.dozzle.group=quadlet

[Install]
WantedBy=omnivore.target