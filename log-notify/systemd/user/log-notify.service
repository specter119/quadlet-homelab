[Unit]
Description=Notify on journal log patterns

[Service]
{{#if (command_success "uname -r | grep -qi wsl")}}
# The user manager's PATH has no /mnt/c entries, so notify.sh cannot find powershell.exe.
Environment=PATH=%h/.local/bin:%h/.nix-profile/bin:/usr/local/bin:/usr/bin:/mnt/c/Windows/System32/WindowsPowerShell/v1.0
{{/if}}
ExecStart=/usr/bin/python3 %h/.local/lib/log-notify/log-notify.py
Restart=always
RestartSec=5s
# No rules -> the script exits 0; don't restart-loop in that case.
RestartPreventExitStatus=0

{{#if (contains autostart_services "log-notify")}}
[Install]
WantedBy=default.target
{{/if}}
