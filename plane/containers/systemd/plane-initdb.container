[Unit]
Description=Initialize Plane PostgreSQL database
After=postgres.service
Requires=postgres.service

{{#if (command_success "uname -r | grep -qi wsl")}}
[Quadlet]
DefaultDependencies=false

{{/if}}
[Service]
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=2s

[Container]
Image=docker.io/postgres:17-alpine
Network=plane.network

Secret=postgres-password,type=env,target=PGPASSWORD

Exec=sh -c "psql -h postgres -U postgres -tc \"SELECT 1 FROM pg_database WHERE datname='plane'\" | grep -q 1 || psql -h postgres -U postgres -c \"CREATE DATABASE plane\""

# Dozzle group
Label=dev.dozzle.group=quadlet

[Install]
WantedBy=plane.target
