[Unit]
Description=OpenFang Agent Runtime
After=traefik.service
Wants=traefik.service
Requires=openfang-prepare.service
After=openfang-prepare.service

{{#if (command_success "uname -r | grep -qi wsl")}}
[Quadlet]
DefaultDependencies=false

{{/if}}
[Service]
Restart=always

[Container]
{{#if (command_success "timedatectl show -p Timezone --value")}}
Environment=TZ={{command_output "timedatectl show -p Timezone --value"}}
{{/if}}
Image=localhost/openfang-runtime:trixie
Pull=never
UserNS=keep-id
NoNewPrivileges=true
Network=traefik.network
Environment=HOME=/home/openfang
Environment=XDG_CONFIG_HOME=/home/openfang/.config
Environment=XDG_CACHE_HOME=/home/openfang/.cache
Environment=PATH=/home/openfang/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Runtime state
Volume=%h/.local:/home/openfang/.local:Z
Volume=%h/.config:/home/openfang/.config:Z
Volume=%h/.cache:/home/openfang/.cache:Z

# Extra user-defined mounts (same pattern as marimo_volumes)
{{#each openfang_volumes}}
Volume={{this}}
{{/each}}

Exec=openfang start

# Dozzle group
Label=dev.dozzle.group=quadlet

# Traefik labels
Label=traefik.enable=true
Label=traefik.docker.network=systemd-traefik

# HTTP -> HTTPS redirect
Label=traefik.http.routers.openfang-http.entrypoints=http
Label=traefik.http.routers.openfang-http.middlewares=redir-https@file
Label=traefik.http.routers.openfang-http.rule=Host(`openfang.{{domain}}`)
Label=traefik.http.routers.openfang-http.service=noop@internal

# HTTPS
Label=traefik.http.routers.openfang-https.entrypoints=https
Label=traefik.http.routers.openfang-https.tls=true
Label=traefik.http.routers.openfang-https.middlewares=gzip@file
Label=traefik.http.routers.openfang-https.rule=Host(`openfang.{{domain}}`)
Label=traefik.http.services.openfang.loadbalancer.server.port=4200

{{#if (contains autostart_services "openfang")}}
[Install]
WantedBy=default.target
{{/if}}
